{
  "name": "@samsara-dev/react-native-testify",
  "version": "0.2.1",
  "packageManager": "pnpm@9.15.0",
  "description": "Component-level visual regression testing for React Native",
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./config": {
      "react-native": "./src/config.ts",
      "types": "./src/config.ts",
      "import": "./dist/src/config.js",
      "require": "./dist/src/config.js"
    }
  },
  "bin": {
    "testify": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "tsx watch cli/index.ts",
    "prepublishOnly": "pnpm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "keywords": [
    "react-native",
    "visual-testing",
    "screenshot",
    "regression",
    "testing",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.65.0"
  },
  "dependencies": {
    "jiti": "^2.4.0",
    "zod": "^3.22.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.4.0",
    "@changesets/cli": "^2.27.8",
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^5.2.4",
    "@types/pngjs": "^6.0.1",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "files": ["dist", "src", "cli", "README.md", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/bheemreddy-samsara/react-native-testify.git"
  },
  "bugs": {
    "url": "https://github.com/bheemreddy-samsara/react-native-testify/issues"
  },
  "homepage": "https://github.com/bheemreddy-samsara/react-native-testify#readme"
}
