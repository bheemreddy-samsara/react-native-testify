{
  "name": "react-native-testify",
  "version": "0.1.0",
  "description": "Component-level visual regression testing for React Native",
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "bin": {
    "testify": "./cli/index.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist/src --external react --external react-native && bun build ./cli/index.ts --outdir ./dist/cli",
    "dev": "bun --watch cli/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "react-native",
    "visual-testing",
    "screenshot",
    "regression",
    "testing",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.65.0"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.4.0",
    "@types/bun": "latest",
    "@types/pixelmatch": "^5.2.4",
    "@types/pngjs": "^6.0.1",
    "@types/react": "^18.0.0",
    "typescript": "^5.0.0"
  },
  "files": ["dist", "src", "cli", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/bheemreddy-samsara/react-native-testify.git"
  },
  "bugs": {
    "url": "https://github.com/bheemreddy-samsara/react-native-testify/issues"
  },
  "homepage": "https://github.com/bheemreddy-samsara/react-native-testify#readme"
}
